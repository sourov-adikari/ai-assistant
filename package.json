{
  "name": "gemini-ai-personal-assistant",
  "version": "3.2.0",
  "private": true,
  "description": "Mobile-first bilingual English/Bengali Gemini AI personal assistant.",
  "main": "server.ts",
  "scripts": {
    "start": "npm run build && tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "build:frontend": "tsx build.ts",
    "build": "npm run build:frontend && tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
